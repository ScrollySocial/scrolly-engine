# Chat Manager settings. The setup skill writes the server's .env from this file (never commit
# .env). Empty values switch that part off: no YouTube key = no YouTube checks, no Apify
# token = no TikTok checks. Who you are and how your pages look: config/profile.json.

# --- server ---
# Your server's web address: yourname.duckdns.org (free) or a subdomain of your own site.
N8N_HOST=yourname.duckdns.org
N8N_WEBHOOK_URL=https://yourname.duckdns.org/
N8N_EDITOR_BASE_URL=https://yourname.duckdns.org/
INBOX_PUBLIC_URL=https://yourname.duckdns.org
# Make once with: openssl rand -hex 32 . Keep a copy in the password manager:
# without it the saved n8n data can't be read after a rebuild.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=America/Chicago
TZ=America/Chicago

# Test mode: nothing is sent to Instagram or YouTube while this is true.
# Flip to false only after the end-to-end test passes.
COMMENTS_DRY_RUN=true
# Secret for the run-now and status webhooks (openssl rand -hex 16).
RUN_SECRET=
# YouTube rows leave the inbox after this many days (Google allows 30).
YOUTUBE_KEEP_DAYS=21
# Comments older than this are skipped (first run won't flood the inbox).
MAX_COMMENT_AGE_HOURS=72

# --- Instagram (Meta app, Instagram API with Instagram Login) ---
META_VERIFY_TOKEN=
META_APP_SECRET=
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_BASE=https://graph.instagram.com/v26.0

# --- YouTube (Google Cloud project, YouTube Data API v3) ---
YT_API_KEY=
YT_CHANNEL_ID=
# For posting approved replies (scripts/youtube-auth.mjs prints the refresh token)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- TikTok (read only, through Apify) ---
TIKTOK_HANDLE=
APIFY_TOKEN=
TIKTOK_MAX_USD=0.10
TIKTOK_VIDEOS=3
TIKTOK_COMMENTS_PER_VIDEO=30

# --- Optional: drafts by the paid Claude API ---
# Off by default: comments are sorted by free word rules and Claude drafts the
# replies on your Claude subscription ("draft my comment replies").
# true = n8n sorts + drafts every comment with the API. Opus 5.5 at low effort is
# under 1 cent per comment; claude-haiku-5-5 well under a tenth of a cent.
CLAUDE_API_DRAFTS=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- Dashboard (inbox/server.mjs at https://<N8N_HOST>/inbox) ---
# Shared secret n8n and the draft-comment-replies skill use (openssl rand -hex 24).
INBOX_API_SECRET=
# One-time code to set the dashboard password on the first visit (openssl rand -hex 6).
INBOX_SETUP_CODE=
# Instagram DMs are read only when true; switch on after the privacy page covers DMs
# and "messages" is subscribed in the Meta app (Webhooks + scripts/instagram-setup.mjs).
DMS_ENABLED=false

# --- Email list (where freebie signups go) ---
# Every signup is always kept on this server too (dashboard → Email list → Download CSV).
# EMAIL_LIST: builtin (no email tool), mailerlite, kit, mailchimp, beehiiv, flodesk or webhook.
# Fill in only the key of the tool you picked.
EMAIL_LIST=builtin
# MailerLite → Integrations → API
MAILERLITE_API_KEY=
# Kit → Settings → Developer → API keys (v4 key)
KIT_API_KEY=
# Mailchimp → Profile → Extras → API keys (ends in -us21 or similar)
MAILCHIMP_API_KEY=
# beehiiv → Settings → Workspace settings → API
BEEHIIV_API_KEY=
# Flodesk → Account settings → Integrations → API keys
FLODESK_API_KEY=
# Webhook: Zapier "Catch Hook", Make "Custom webhook", an n8n Webhook node, or any tool's URL.
# The secret (optional) signs each call: header X-Signature = sha256=<HMAC-SHA256 of the body>.
LIST_WEBHOOK_URL=
LIST_WEBHOOK_SECRET=
