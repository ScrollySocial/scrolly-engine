{
  "name": "Discover — Intake & Kickoff",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tally-intake",
        "responseMode": "onReceived",
        "responseData": "{\"received\": true}",
        "options": {}
      },
      "id": "webhook_tally",
      "name": "Tally Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "ba6c1901-2fe3-4913-b913-857b900678d3"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body;\nconst fields = body?.data?.fields || [];\nconst find = (key) => { const f = fields.find(f => f.key === key || f.label === key); return f ? f.value : null; };\nreturn [{ json: { orderId: find('order_id'), orderKey: find('order_key') } }];"
      },
      "id": "code_extract_order",
      "name": "Extract order info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://{{ $env.WC_STORE_BASE_URL || 'scrollyseo.com' }}/wp-json/wc/v3/orders/{{ $json.orderId }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "consumer_key", "value": "={{ $env.WC_AUDIT_CONSUMER_KEY }}" },
            { "name": "consumer_secret", "value": "={{ $env.WC_AUDIT_CONSUMER_SECRET }}" }
          ]
        },
        "options": {}
      },
      "id": "http_get_wc_order",
      "name": "Fetch WooCommerce order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const order = $json;\nconst expectedKey = $('Extract order info').item.json.orderKey;\nconst expectedProductId = String($env.WC_AUDIT_PRODUCT_ID || '24');\nconst statusOk = ['processing', 'completed'].includes(order.status);\nconst keyOk = Boolean(order.order_key) && Boolean(expectedKey) && order.order_key === expectedKey;\nconst totalOk = parseFloat(order.total) === 299;\nconst productOk = Array.isArray(order.line_items) && order.line_items.some(li => String(li.product_id) === expectedProductId);\nconst verified = Boolean(statusOk && keyOk && totalOk && productOk);\nreturn [{ json: { verified, orderId: order.id || null, orderKey: order.order_key || null, status: order.status || null, total: order.total || null, statusOk, keyOk, totalOk, productOk } }];"
      },
      "id": "code_evaluate_order",
      "name": "Evaluate order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.verified }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        },
        "options": {}
      },
      "id": "if_paid",
      "name": "Order verified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:{{ $env.BRIDGE_PORT || 5679 }}/create-engagement",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Tally Webhook').item.json.body) }}",
        "options": {}
      },
      "id": "http_create_engagement",
      "name": "Create engagement (bridge)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, -120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:{{ $env.BRIDGE_PORT || 5679 }}/launch-runner",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ slug: $json.slug }) }}",
        "options": {}
      },
      "id": "http_launch_runner",
      "name": "Launch runner (bridge)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, -120]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { rejected: true, reason: 'WooCommerce order not paid, not found, or order_id/order_key missing/invalid', orderId: $json.orderId || null, status: $json.status || null } }];"
      },
      "id": "code_rejected",
      "name": "Log rejected submission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:{{ $env.BRIDGE_PORT || 5679 }}/build-email-payload",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ mode: 'access-request', slug: $json.slug }) }}",
        "options": {}
      },
      "id": "http_build_access_request",
      "name": "Build access-request email (bridge)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 40]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "notEquals" }
            }
          ]
        },
        "options": {}
      },
      "id": "if_access_request_needed",
      "name": "Access request needed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1540, 40]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.RESEND_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "http_send_access_request",
      "name": "Send access-request email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 40]
    }
  ],
  "connections": {
    "Tally Webhook": { "main": [[{ "node": "Extract order info", "type": "main", "index": 0 }]] },
    "Extract order info": { "main": [[{ "node": "Fetch WooCommerce order", "type": "main", "index": 0 }]] },
    "Fetch WooCommerce order": { "main": [[{ "node": "Evaluate order", "type": "main", "index": 0 }]] },
    "Evaluate order": { "main": [[{ "node": "Order verified?", "type": "main", "index": 0 }]] },
    "Order verified?": {
