        "method": "POST",
        "url": "=http://host.docker.internal:{{ $env.BRIDGE_PORT || 5679 }}/mark-delivered",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ slug: $('Merge slug with token result').item.json.slug }) }}",
        "options": {}
      },
      "id": "http_mark_delivered",
      "name": "Mark delivered (bridge)",
      "type": "n8n-nodes-base.httpRequest",
