# Copy this file to .env and fill in real values. Never commit .env.

# --- Anthropic (powers the headless Discover agent runner) ------------------
# Required. This must be a real API key from console.anthropic.com/settings/keys
# with its own billing enabled — separate from any Claude.ai/Claude Code
# subscription login. The runner shells out to the Claude Agent SDK's bundled
# executable, which authenticates via this key, not via any interactive
# `claude` login on this machine (confirmed during the 2026-08-10 smoke test:
# with no key set, the run failed immediately with "Not logged in").
ANTHROPIC_API_KEY=
# Per-engagement Anthropic API spend ceiling (separate from DataForSEO cost).
# The runner passes this as maxBudgetUsd; the SDK stops the run if exceeded.
ANTHROPIC_MAX_BUDGET_USD=15

# --- DataForSEO ---------------------------------------------------------
# Leave DATAFORSEO_ENABLED=false until the account is funded and you've run
# the plan's step-7 live verification. When false, the runner omits the
# dataforseo MCP server entirely and the report correctly marks those
# sections "Not Evaluated / Data Required" per discover.md's fallback rules.
DATAFORSEO_ENABLED=false
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=
# Pre-authorized paid-call ceiling per engagement, per discover-engine.md's
# Automated Mode section. Starting default; recalibrate after real runs.
DATAFORSEO_CALL_CEILING=60

# --- Stripe --------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Tally -----------------------------------------------------------------
TALLY_WEBHOOK_SECRET=

# --- Resend (email delivery) ------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OPERATOR_EMAIL=
SENDER_DISPLAY_NAME=

# --- n8n --------------------------------------------------------------------
# Filled in once the n8n workflows are imported and their webhook nodes exist.
N8N_INTAKE_WEBHOOK_URL=
N8N_ENGAGEMENT_COMPLETE_WEBHOOK_URL=
N8N_APPROVE_AND_SEND_WEBHOOK_URL=

# --- Delivery pipeline behavior -----------------------------------------
# true  = every finished report emails the operator for review; client email
#         only sends after the operator clicks "Approve & Send" (current default).
# false = skip the review step and email the client automatically once the
#         Final Quality Gate has run. Flip this only after watching several
#         reviewed runs succeed (see plan's Build Order).
REQUIRE_MANUAL_APPROVAL=true
