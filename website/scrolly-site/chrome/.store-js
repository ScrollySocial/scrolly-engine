(function(){if(window.__scxg)return;window.__scxg=1;var root=function(){return document.querySelector('.scxg.scxg-head')};function set(o){var r=root();if(!r)return;r.classList.toggle('scxg-open',o);var b=r.querySelector('[data-scxg-open]');if(b)b.setAttribute('aria-expanded',o?'true':'false');var d=r.querySelector('.scxg-drawer');if(d)d.setAttribute('aria-hidden',o?'false':'true');document.documentElement.style.overflow=o?'hidden':'';if(o){var c=r.querySelector('.scxg-dclose');c&&c.focus()}else if(b&&r.__was){b.focus()}r.__was=o}document.addEventListener('click',function(e){var t=e.target.closest('[data-scxg-open],[data-scxg-close]');if(t){set(t.hasAttribute('data-scxg-open'));return}var a=e.target.closest('.scxg-drawer a');if(a)set(false);});document.addEventListener('keydown',function(e){var r=root();if(e.key==='Escape'&&r&&r.classList.contains('scxg-open'))set(false)});})();