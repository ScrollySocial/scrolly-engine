@import url('https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=Caveat+Brush&family=Public+Sans:wght@400;500;600;700;800&display=swap');html body #site-header,html body #site-footer{display:none!important}body{background:#fbf8f3}.scxg{--black:#000;--cream:#fbf8f3;--orange:#ff6338;--lav:#c1aefc;--peach:#ffb38f;--gut:clamp(20px,6.1vw,88px);--disp:'Archivo','Arial Black',Impact,sans-serif;font-family:'Public Sans',system-ui,Arial,sans-serif;font-size:16px;line-height:1.45;color:var(--black);position:relative}.scxg *,.scxg *::before,.scxg *::after{box-sizing:border-box}.scxg a{color:inherit}.scxg ul,.scxg li{list-style:none;margin:0;padding:0}.scxg :focus-visible{outline:3px solid #735cff;outline-offset:3px}.scxg svg{display:block}.scxg-hdr{position:relative;z-index:60;height:85px;padding:0 var(--gut);display:flex;align-items:center;background:var(--cream)}.scxg-logo{display:block;flex:none;color:var(--black);width:128px}.scxg-logo svg{width:100%;height:auto}.scxg-hdr nav{display:flex;align-items:center;gap:clamp(24px,3.2vw,46px);font-size:16px;font-weight:700;margin:0 auto}.scxg-hdr nav a{text-decoration:none;white-space:nowrap;padding:6px 0;border-bottom:2px solid transparent}.scxg-hdr nav a:hover{border-bottom-color:var(--orange)}.scxg-right{display:flex;align-items:center;gap:clamp(22px,3.4vw,50px);flex:none}.scxg-login{display:flex;align-items:center;gap:6px;font-size:19px;font-weight:700;text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:2px}.scxg-burger{width:44px;height:44px;display:flex;align-items:center;justify-content:center;border:0;background:transparent;color:var(--black);padding:0;cursor:pointer}@media(min-width:1400px){.scxg-hdr nav{margin:0 auto 0 339px}}@media(max-width:1099px){.scxg-hdr nav{display:none}.scxg-right{margin-left:auto}}@media(max-width:520px){.scxg-hdr{height:72px}.scxg-logo{width:106px}.scxg-login{font-size:16px}.scxg-right{gap:12px}}.scxg-bg{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.6);z-index:99998}.scxg-drawer{display:none;position:fixed;top:0;right:0;bottom:0;width:min(440px,100%);background:var(--black);color:#fff;z-index:99999;overflow-y:auto;padding:22px 28px 40px}.scxg.scxg-open .scxg-drawer{display:block;animation:scxgin .25s ease-out}.scxg.scxg-open .scxg-bg{display:block}@keyframes scxgin{from{transform:translateX(100%)}to{transform:none}}@media(prefers-reduced-motion:reduce){.scxg.scxg-open .scxg-drawer{animation:none}}.scxg-dtop{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.scxg-dtop span{font-family:var(--disp);font-weight:900;text-transform:uppercase;font-size:20px;color:var(--lav)}.scxg-dclose{width:44px;height:44px;border:2px solid #fff;border-radius:50%;background:transparent;color:#fff;font-size:26px;line-height:1;cursor:pointer;padding:0}.scxg-drawer a{display:block;text-decoration:none;color:#fff}.scxg-drawer a:hover{color:var(--peach)}.scxg-drawer .top>li>a{font-family:var(--disp);font-weight:900;text-transform:uppercase;font-size:30px;line-height:1.1;padding:12px 0 6px;letter-spacing:-.01em}.scxg-drawer .top ul a{font-size:16px;font-weight:600;padding:5px 0 5px 14px;border-left:2px solid rgba(255,255,255,.25)}.scxg-drawer .acct{margin-top:26px;border-top:1px solid rgba(255,255,255,.25);padding-top:14px}.scxg-drawer .acct a{font-size:18px;font-weight:700;padding:7px 0}.scxg-ftr{background:var(--black);color:#fff;padding:38px var(--gut) 26px}.scxg-ftr .row1{display:flex;align-items:center;justify-content:space-between;gap:24px 46px;flex-wrap:wrap}.scxg-ftr .logo{display:block;width:116px;color:#fff}.scxg-ftr .logo svg{width:100%;height:auto}.scxg-ftr nav ul{display:flex;gap:12px 30px;flex-wrap:wrap;font-size:14px;font-weight:600}.scxg-ftr a{text-decoration:none}.scxg-ftr a:hover{text-decoration:underline}.scxg-ftr hr{border:0;height:1px;background:rgba(255,255,255,.2);margin:26px 0 16px}.scxg-ftr .copy{font-size:13px;line-height:16px;color:rgba(255,255,255,.9)}