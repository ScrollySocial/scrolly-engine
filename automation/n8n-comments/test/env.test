# Local test settings: every API points at test/mock-apis.mjs on the host.
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5688/
N8N_ENCRYPTION_KEY=local-test-only-not-a-secret
GENERIC_TIMEZONE=America/Chicago
N8N_CONCURRENCY_PRODUCTION_LIMIT=1
N8N_RUNNERS_TASK_TIMEOUT=600
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto,fs
KEYWORDS_FILE=/data/config/keywords.json
N8N_DIAGNOSTICS_ENABLED=false
N8N_SECURE_COOKIE=false
COMMENTS_DRY_RUN=false
RUN_SECRET=test-run-secret
MAX_COMMENT_AGE_HOURS=72
META_VERIFY_TOKEN=test-verify
META_APP_SECRET=test-app-secret
IG_USER_ID=17840000000000001
IG_ACCESS_TOKEN=test-ig-token
GRAPH_BASE=http://host.docker.internal:5690/graph
IG_REFRESH_URL=http://host.docker.internal:5690/graph/refresh
YT_API_KEY=test-yt-key
YT_CHANNEL_ID=UCscrolly
YT_BASE=http://host.docker.internal:5690/yt
YT_CLIENT_ID=test
YT_CLIENT_SECRET=test
YT_REFRESH_TOKEN=test
GOOGLE_TOKEN_URL=http://host.docker.internal:5690/google-token
TIKTOK_HANDLE=scrollysocial
APIFY_TOKEN=test-apify
APIFY_BASE=http://host.docker.internal:5690/apify
ANTHROPIC_API_KEY=test-anthropic
ANTHROPIC_BASE=http://host.docker.internal:5690/anthropic
INBOX_BASE=http://host.docker.internal:5691
INBOX_API_SECRET=test-inbox-secret
DMS_ENABLED=true
INBOX_PUBLIC_URL=http://localhost:5691
