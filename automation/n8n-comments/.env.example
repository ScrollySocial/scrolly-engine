# Copy to .env on the server (never commit .env). Empty values switch that part
# off: no YouTube key = no YouTube checks, no Apify token = no TikTok checks.

# --- server ---
N8N_HOST=hooks.scrollyseo.com
N8N_WEBHOOK_URL=https://hooks.scrollyseo.com/
N8N_EDITOR_BASE_URL=https://hooks.scrollyseo.com/
# Make once with: openssl rand -hex 32 . Keep a copy in the password manager:
# without it the saved n8n data can't be read after a rebuild.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=America/Chicago
TZ=America/Chicago

# Test mode: nothing is sent to Instagram or YouTube while this is true.
# Flip to false only after the end-to-end test with Mercedes's OK.
COMMENTS_DRY_RUN=true
# Secret for the run-now and status webhooks (openssl rand -hex 16).
RUN_SECRET=
# YouTube rows leave the Comment inbox after this many days (Google allows 30;
# 21 leaves room for Notion's page history and trash).
YOUTUBE_KEEP_DAYS=21
# Comments older than this are skipped (first run won't flood the inbox).
MAX_COMMENT_AGE_HOURS=72

# --- Instagram (Meta app, Instagram API with Instagram Login) ---
META_VERIFY_TOKEN=
META_APP_SECRET=
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_BASE=https://graph.instagram.com/v26.0

# --- YouTube (Google Cloud project, YouTube Data API v3) ---
YT_API_KEY=
YT_CHANNEL_ID=
# For posting approved replies (scripts/youtube-auth.mjs prints the refresh token)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- TikTok (read only, through Apify) ---
TIKTOK_HANDLE=
APIFY_TOKEN=
TIKTOK_MAX_USD=0.10
TIKTOK_VIDEOS=3
TIKTOK_COMMENTS_PER_VIDEO=30

# --- Optional: drafts by the paid Claude API ---
# Off by default: comments are sorted by free word rules and Claude drafts the
# replies on the Claude subscription (vault skill draft-comment-replies).
# true = n8n sorts + drafts every comment with the API. Opus 5.5 at low effort is
# under 1 cent per comment; claude-haiku-5-5 well under a tenth of a cent.
CLAUDE_API_DRAFTS=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- Notion (Comment inbox in the Scrolly Content Tracker) ---
NOTION_TOKEN=
# Comment inbox database (Scrolly Content Tracker); the token comes from a Notion
# internal integration connected to that database.
NOTION_COMMENTS_DB=68aae53117cf46699efabacf91695b59
