# HTTPS for the comments n8n and the comment dashboard. Caddy gets and renews the
# certificate on its own once the DNS record for N8N_HOST (hooks.scrollyseo.com)
# points at this server.
{$N8N_HOST} {
	encode gzip
	# The dashboard and its API (inbox/server.mjs); everything else is n8n.
	handle /inbox* {
		reverse_proxy inbox:3000
	}
	handle {
		reverse_proxy n8n:5678
	}
}
