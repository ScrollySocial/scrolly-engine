ject-position:center bottom}.hp-calc{padding:42px 0 54px;scroll-margin-top:20px}.hp-calc .wrap{display:grid;grid-template-columns:1.35fr .55fr;gap:70px;align-items:center}.hp-calc h2{font:400 clamp(3rem,5vw,5.4rem)/1 var(--serif);margin:0 0 28px}.hp-calc form{display:grid;grid-template-columns:1fr 1fr auto;gap:22px;align-items:start}.hp-calc input{width:100%;min-height:56px;background:rgba(255,255,255,.5);border:1px solid var(--line);border-radius:4px;padding:14px 16px;font:1.4rem var(--serif);color:var(--ink)}.hp-calc label{display:block;color:var(--muted);font-size:.95rem;margin-top:9px}.hp-calc .go{width:56px;height:56px;border-radius:50%;border:0;background:var(--orange);color:#000;font-size:1.5rem;line-height:1;cursor:pointer}.hp-calc .go:hover{background:#000;color:#fff}.hp-calc .res{padding-left:70px}.hp-calc .num{font:400 5.5rem/.8 var(--serif);color:var(--or-text)}.hp-calc .word{font:400 2.3rem/1 var(--serif);margin:12px 0}.hp-clubs{padding:60px 0 35px;scroll-margin-top:20px}.hp-clubs h2{text-align:center;font:400 clamp(3rem,4.6vw,5rem)/1 var(--serif);margin:0 0 42px}.hp-clubs .grid{display:grid;grid-template-columns:repeat(3,1fr)}.hp-club{padding:0 34px 18px;min-width:0}.hp-club h3{font:400 clamp(3.4rem,5vw,5.6rem)/1 var(--serif)}.hp-club img{height:175px;width:100%;object-fit:contain;object-position:center;margin:12px auto}.hp-club .cta{display:flex;justify-content:center;margin-top:10px}.hp-club .btn{padding:14px 30px;letter-spacing:0;text-transform:none;font-size:1.05rem}.hp-clubs .fine{text-align:center}.hp-earned{padding:45px 0 0}.hp-earned .wrap{display:grid;grid-template-columns:1fr 1fr;align-items:center}.hp-earned .copy{padding:50px 3vw 70px 0}.hp-earned h2{font:400 clamp(2.4rem,3.15vw,5.2rem)/1 var(--serif);margin:0 0 26px;letter-spacing:-.035em}.hp-earned h2 span{display:block;white-space:nowrap}.hp-earned p{font:1.25rem/1.45 var(--serif);max-width:430px}.hp-earned .tabs{display:flex;flex-wrap:wrap;gap:0 42px;margin-top:26px}.hp-earned .tabs a{d