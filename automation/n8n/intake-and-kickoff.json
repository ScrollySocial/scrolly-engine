{
  "name": "Discover — Intake & Kickoff",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tally-intake",
        "responseMode": "onReceived",
        "responseData": "{\"received\": true}",
        "options": {}
      },
      "id": "webhook_tally",
      "name": "Tally Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body;\nconst fields = body?.data?.fields || [];\nconst sessionField = fields.find(f => f.key === 'session_id' || f.label === 'session_id');\nreturn [{ json: { sessionId: sessionField ? sessionField.value : null } }];"
      },
      "id": "code_extract_session",
      "name": "Extract session_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.stripe.com/v1/checkout/sessions/{{ $json.sessionId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.STRIPE_SECRET_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "http_verify_stripe",
      "name": "Verify Stripe Session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.payment_status }}",
              "rightValue": "paid",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        },
        "options": {}
      },
      "id": "if_paid",
      "name": "Payment verified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:{{ $env.BRIDGE_PORT || 5679 }}/create-engagement",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Tally Webhook').item.json.body) }}",
        "options": {}
      },
      "id": "http_create_engagement",
      "name": "Create engagement (bridge)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, -120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:{{ $env.BRIDGE_PORT || 5679 }}/launch-runner",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ slug: $json.slug }) }}",
        "options": {}
      },
      "id": "http_launch_runner",
      "name": "Launch runner (bridge)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, -120]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { rejected: true, reason: 'Stripe session not paid or session_id missing/invalid', sessionId: $json.sessionId || null, stripeStatus: $json.payment_status || null } }];"
      },
      "id": "code_rejected",
      "name": "Log rejected submission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 120]
    }
  ],
  "connections": {
    "Tally Webhook": { "main": [[{ "node": "Extract session_id", "type": "main", "index": 0 }]] },
    "Extract session_id": { "main": [[{ "node": "Verify Stripe Session", "type": "main", "index": 0 }]] },
    "Verify Stripe Session": { "main": [[{ "node": "Payment verified?", "type": "main", "index": 0 }]] },
    "Payment verified?": {
      "main": [
        [{ "node": "Create engagement (bridge)", "type": "main", "index": 0 }],
        [{ "node": "Log rejected submission", "type": "main", "index": 0 }]
      ]
    },
    "Create engagement (bridge)": { "main": [[{ "node": "Launch runner (bridge)", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
