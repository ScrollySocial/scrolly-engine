# Copy this file to .env and fill in real values. Never commit .env.
#
# IMPORTANT: n8n runs inside a Docker container (see automation/README.md's
# "Docker, not npm" section), which is a separate environment from this
# machine — it cannot read this file directly. This .env is used two ways:
#   1. automation/bridge-server.mjs and automation/runner/run-discover.mjs
#      (both running natively on Windows) load it normally via dotenv.
#   2. The n8n container must be started with `--env-file automation/.env`
#      so its own $env.X expressions (used throughout the workflow JSON
#      files for things like $env.STRIPE_SECRET_KEY) can see the same values.
#      See README.md for the full `docker run` command.

# --- Anthropic (powers the headless Discover agent runner) ------------------
# Required. This must be a real API key from console.anthropic.com/settings/keys
# with its own billing enabled — separate from any Claude.ai/Claude Code
# subscription login. The runner shells out to the Claude Agent SDK's bundled
# executable, which authenticates via this key, not via any interactive
# `claude` login on this machine (confirmed during the 2026-08-10 smoke test:
# with no key set, the run failed immediately with "Not logged in").
ANTHROPIC_API_KEY=
# Per-engagement Anthropic API spend ceiling (separate from DataForSEO cost).
# The runner passes this as maxBudgetUsd; the SDK stops the run if exceeded.
ANTHROPIC_MAX_BUDGET_USD=15

# --- DataForSEO ---------------------------------------------------------
# Leave DATAFORSEO_ENABLED=false until the account is funded and you've run
# the plan's step-7 live verification. When false, the runner omits the
# dataforseo MCP server entirely and the report correctly marks those
# sections "Not Evaluated / Data Required" per discover.md's fallback rules.
DATAFORSEO_ENABLED=false
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=
# Pre-authorized paid-call ceiling per engagement, per discover-engine.md's
# Automated Mode section. Starting default; recalibrate after real runs.
DATAFORSEO_CALL_CEILING=60

# --- Stripe --------------------------------------------------------------
# NOTE (2026-08-24): the pipeline's payment trust boundary changed. Stripe is
# now connected through WooCommerce's own checkout (Stripe Elements embedded
# in the WooCommerce Blocks checkout), not a standalone Stripe Payment Link —
# so there is no Stripe Checkout Session for n8n to verify against anymore.
# Verification now happens against the WooCommerce Order REST API instead
# (see the "WooCommerce (order verification)" block below). These two Stripe
# vars are no longer read by any workflow/script — kept only in case a future
# reconciliation step wants direct Stripe API access. Safe to leave blank.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- WooCommerce (order verification — replaces the old Stripe Payment Link
# session_id check now that Stripe runs through WooCommerce's checkout) -----
# After a customer pays on scrollyseo.com/checkout, WooCommerce's own
# order-received/thank-you page carries order_id + order_key (see
# automation/woocommerce-thankyou-snippet.php, which must be installed on
# the live site to hand these to the Tally form as hidden fields). n8n's
# "Intake & Kickoff" workflow independently re-fetches the order from
# WooCommerce's REST API and checks status/total/order_key/product line item
# before trusting the submission — this is the real payment gate, exactly
# like the old Stripe session check was, just against a different API.
WC_STORE_BASE_URL=scrollyseo.com
# WooCommerce → Settings → Advanced → REST API → Add key. Read permission is
# enough (this only ever fetches one order to verify it, never writes).
# Keep separate from the Implementation Agent's WC_CONSUMER_KEY/SECRET below
# — different product, different credential, different blast radius.
WC_AUDIT_CONSUMER_KEY=
WC_AUDIT_CONSUMER_SECRET=
# WooCommerce product ID for the $299 "SEO Site Audit" listing. Confirmed 24
# as of 2026-08-20 (current-state.md) — double check in wp-admin before relying on it.
WC_AUDIT_PRODUCT_ID=24

# --- $1K Club (see automation/club/README.md) -------------------------------
# WooCommerce product IDs for the $1K Club ($50) and $1K Challenge ($25)
# products. Created 2026-09-11 as draft/catalog-hidden -- 279 and 280 on the
# live site. Not publicly purchasable until explicitly published.
WC_CLUB_PRODUCT_ID=
WC_CHALLENGE_PRODUCT_ID=
# Shared HMAC secret between this bridge server and the WordPress
# club-access-route.php snippet (automation/wordpress/deployed/) -- must be
# the exact same value in both places, or every access token fails
# verification. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real value or print it anywhere (chat, logs, status reports).
CLUB_ACCESS_TOKEN_SECRET=

# --- Intake reminder (check-pending-intakes.mjs) ----------------------------
# The real, existing Tally intake form — confirmed live 2026-08-24 at
# https://tally.so/r/D4OVlE, with order_id/order_key hidden fields (see
# tally-form-spec.md). Must match woocommerce-thankyou-snippet.php's hardcoded
# copy of the same URL (that file is PHP running on WordPress, so it can't
# read this .env — the two are kept in sync by hand).
TALLY_FORM_URL=https://tally.so/r/D4OVlE
# How long to wait after a paid order before the FIRST reminder (give them a
# real chance to just click the thank-you-page button first).
INTAKE_REMINDER_DELAY_HOURS=3
# Spacing between repeat reminders — keeps nagging once per day (by default)
# until the customer completes intake or INTAKE_REMINDER_MAX_AGE_DAYS is hit.
INTAKE_REMINDER_INTERVAL_HOURS=24
# Stop reminding entirely (and assume a human should follow up manually) after this many days.
INTAKE_REMINDER_MAX_AGE_DAYS=7

# --- Tally -----------------------------------------------------------------
TALLY_WEBHOOK_SECRET=

# --- Resend (email delivery) ------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OPERATOR_EMAIL=
SENDER_DISPLAY_NAME=
# The email address clients are asked to add as a view-only user on their own
# GBP/GSC/GA4 (see automation/email-templates/access-request.html and
# build-resend-payload.mjs's access-request mode). Falls back to
# RESEND_FROM_EMAIL if unset — set this separately if you'd rather use a
# distinct address for account-access grants than for sending mail.
SCROLLY_ACCESS_EMAIL=

# --- Implementation Agent: production orchestration (added 2026-08-24, see
# methodology/implementation-agent.md's "Production Orchestration" section) ---
# WooCommerce product ID for the ~$999 Implementation product. Real WC
# webhooks (n8n/implementation-kickoff.json) carry the order object
# directly — no Tally form needed for this product, unlike the audit.
WC_IMPLEMENTATION_PRODUCT_ID=
# Where customers download connector-plugin/scrolly-connector.php — host it
# somewhere and put the real URL here (not built/hosted this session).
SCROLLY_CONNECTOR_PLUGIN_URL=
# The public n8n webhook URL for implementation-site-connection.json (the
# SAME kind of Cloudflare Quick Tunnel URL already used for the other three
# webhooks — mints fresh on every tunnel restart, update this then too).
SCROLLY_CONNECTOR_CALLBACK_URL=
# true = Level-1 field tasks (title/meta/alt/WC fields) wait for a manual
# `node automation/implementation/approve.mjs <slug> all approve` before
# applying. false (default) = fully automatic, matching "maximum
# automation, minimal customer interaction" — Mercedes is the standing QA
# layer either way per implementation-agent.md §5, this only controls
# whether that review is synchronous/blocking or after-the-fact.
REQUIRE_MERCEDES_REVIEW=false

# --- Implementation Agent: LLM router (methodology/implementation-agent.md §9) ---
# Provider-neutral — implementation/lib/llm-router.mjs is the only file that
# reads these. V1 always routes to one configured provider; LLM_PROVIDER
# exists so switching providers later is a config change, not a code change.
LLM_PROVIDER=anthropic
LLM_MODEL_ANTHROPIC=claude-sonnet-4-5-20250929
# ANTHROPIC_API_KEY (above) is reused for this — same key, same billing.

# --- Implementation Agent: CMS target (methodology/implementation-agent.md §10) ---
# CMS_MODE=mock (default if unset) exercises the full task lifecycle against
# an in-memory fake site — no real credentials needed. Set CMS_MODE=live and
# fill in the rest of this block only once a real WordPress/WooCommerce test
# site exists (Application Password +, if testing WooCommerce fields, a REST
# Consumer Key/Secret) AND that site has the REST-bridge mu-plugin installed
# (see implementation/scripts/wp-rest-bridge-mu-plugin.php — required because
# neither Yoast nor Rank Math expose their title/description fields to the
# REST API for writing by default).
CMS_MODE=mock
SEO_PLUGIN=yoast
WP_BASE_URL=
WP_APP_USER=
WP_APP_PASSWORD=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# --- Customer order tracker (scripts/sync-order-tracker.mjs) ----------------
# Dedicated WordPress service user for the Scrolly Order Tracker mu-plugin
# (see automation/wordpress/scrolly-order-tracker-mu-plugin.php) — deliberately
# NOT the same credential as WC_CONSUMER_KEY/SECRET or WC_AUDIT_*. This user
# holds only the plugin's own custom capability (scrolly_manage_order_tracker),
# never a generic WooCommerce Read/Write key, so a leaked credential here
# cannot touch order totals, payments, or any field beyond the five
# _scrolly_* status keys and the report-file upload route.
# NOT YET IN USE — the mu-plugin is not installed yet; leave blank until the
# Setup steps at the bottom of that file are complete and Mercedes has
# approved the first live write.
WP_TRACKER_BASE_URL=https://scrollyseo.com
WP_TRACKER_USER=
WP_TRACKER_APP_PASSWORD=

# --- n8n --------------------------------------------------------------------
# Filled in once the n8n workflows are imported and their webhook nodes exist.
N8N_INTAKE_WEBHOOK_URL=
N8N_ENGAGEMENT_COMPLETE_WEBHOOK_URL=
N8N_APPROVE_AND_SEND_WEBHOOK_URL=

# --- Bridge server -----------------------------------------------------------
# automation/bridge-server.mjs listens on this port natively on Windows.
# The n8n workflows (running inside Docker) reach it at
# http://host.docker.internal:<this port> — Docker Desktop's built-in DNS
# name for the host machine. Only change this if 5679 is already in use.
BRIDGE_PORT=5679

# --- Delivery pipeline behavior -----------------------------------------
# true  = every finished report emails the operator for review; client email
#         only sends after the operator clicks "Approve & Send" (current default).
# false = skip the review step and email the client automatically once the
#         Final Quality Gate has run. Flip this only after watching several
#         reviewed runs succeed (see plan's Build Order).
REQUIRE_MANUAL_APPROVAL=true
